FROM registry.redhat.io/openshift/golang-builder:golang-builder-v1.26-rhel9 AS toolchain

# Run this with docker build --build_arg $(go env GOPROXY) to override the goproxy
ARG goproxy=https://proxy.golang.org
ENV GOPROXY=$goproxy

FROM toolchain AS builder

USER 0
WORKDIR /workspace

ENV GOFLAGS="-buildvcs=false"

COPY ./ ./

# Cache deps before building and copying source so that we don't need to re-download as much
# and so that source changes don't invalidate our downloaded layer
RUN  --mount=type=cache,target=/root/.local/share/golang \
     --mount=type=cache,target=/go/pkg/mod \
     go mod download

# Build
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.local/share/golang \
    CGO_ENABLED=1 GOOS=linux GOARCH=${ARCH} go build -o ./manager .

RUN /usr/bin/strip ./manager

# Copy the aso-controller into the final image.
# NOTE: the final image must be ubi-minimal (not ubi-micro): the manager is
# built with CGO_ENABLED=1 and the payload FIPS checks require a FIPS-certified
# crypto library (libcrypto.so / usr/lib64/ossl-modules/fips.so) in the runtime
# image, which ubi-micro does not ship.
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest@sha256:1d7c5517a4a1a8e2688620b39ee980e82505ca1ab7ae5541b5463120ae9b3897
COPY --from=builder /workspace/manager /manager
USER 65532:65532
ENTRYPOINT ["/manager"]
